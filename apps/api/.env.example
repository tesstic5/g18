# IANA zone for the platform's day boundary (daily limits, stats, rakeback).
# Unset = UTC. Example: PLATFORM_TZ="Asia/Karachi"
DATABASE_URL="postgresql://user:pass@localhost:5432/casino?schema=public"
REDIS_URL="redis://:password@localhost:6379"

# ── JWT RS256 (asymmetric) ────────────────────────────────────────────────
# HMAC JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / JWT_ADMIN_SECRET are retired.
# All tokens (player access, refresh, admin, admin-ws) are RS256-signed with
# JWT_PRIVATE_KEY. Trust domains are separated by issuer + role claims
# (apps/api/src/lib/jwt-claims.ts), not by separate secrets.
#
# Generate:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Paste the PEM (or the base64 one-liner) below. NEVER Ed25519 — jsonwebtoken
# is configured for algorithm: 'RS256' only.
JWT_PRIVATE_KEY=""
# JWT_PUBLIC_KEY=""
# Single-line base64 variants (Dokploy/Coolify env fields):
# JWT_PRIVATE_KEY_B64=""
# JWT_PUBLIC_KEY_B64=""

AES_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CSRF_SECRET="random-string-for-csrf-tokens"
COOKIE_SECRET="cookie-secret"
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://storage.yourdomain.com"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_DEPOSITS="deposit-proofs"
S3_BUCKET_AVATARS="user-avatars"
PORT=4000
HOST="0.0.0.0"
TRUST_PROXY="127.0.0.1"
NODE_ENV="development"
LOG_LEVEL="info"
LOG_PRETTY="false"
ADMIN_DEFAULT_USERNAME="superadmin"
ADMIN_DEFAULT_PASSWORD="change-this-immediately"
# Optional: POST target for worker reconciliation alerts
# RECONCILE_WEBHOOK_URL="https://hooks.example/reconcile"
# RETIRED: outcome overrides were removed. Force-win/lose + difficulty now live in the
# per-game GameConfig (admin panel → Games), which is production-safe and auditable.
# ALLOW_OUTCOME_OVERRIDES is ignored in NODE_ENV=production.
